# Secrets: never commit production values.
KUSYS_DB_PASSWORD=replace-me
KUSYS_MASTER_KEY=replace-with-at-least-32-random-characters

# Runtime
KUSYS_CONFIG_FILE=/app/config/kusys.yaml
KUSYS_SECURE_COOKIES=false
KUSYS_FRONTEND_ORIGIN=http://localhost:5173
KUSYS_FRONTEND_PORT=5173
KUSYS_BACKEND_PORT=8000

# Optional overrides (environment wins over YAML)
# KUSYS_SESSION_IDLE_MINUTES=480
# KUSYS_SESSION_ABSOLUTE_HOURS=24
# KUSYS_OCR_THRESHOLD_CHARS_PER_PAGE=120
# KUSYS_MAX_UPLOAD_BYTES=209715200
# KUSYS_MAX_PDF_PAGES=500
# KUSYS_HOURS_PER_DAY_DEFAULT=8
# KUSYS_VAT_PERCENT_DEFAULT=19
# KUSYS_FOUR_EYES_DEFAULT=true
# KUSYS_ANALYSIS_MAX_CHARS=60000

# Dev frontend only; production reverse-proxies /api/v1 same-origin.
VITE_API_URL=http://localhost:8000/api/v1
